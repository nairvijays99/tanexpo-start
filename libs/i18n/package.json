{
  "name": "@libs/i18n",
  "description": "Shared i18n library for Expo and TanStack Start",
  "version": "0.0.1",
  "packageManager": "pnpm@10.20.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate:keys": "tsx scripts/generate-keys.ts",
    "watch:keys": "tsx watch --include src/resources scripts/generate-keys.ts"
  },
  "peerDependencies": {
    "react": ">=19.1.0",
    "react-native": ">=0.81.5",
    "react-native-web": ">=0.21.0"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "~0.21.0"
  },
  "dependencies": {
    "expo-localization": "^17.0.8",
    "i18next": "^25.7.4",
    "i18next-resources-to-backend": "^1.2.1",
    "react-i18next": "^16.5.3"
  }
}
